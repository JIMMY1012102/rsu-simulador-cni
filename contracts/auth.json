{
  "modulo": "auth",
  "responsable": "Sebastián (asignado originalmente a Jimmy)",
  "autenticacion": "Tokens de Laravel Sanctum. Después del login, enviar el token en cada petición: Authorization: Bearer <token>.",
  "reglas": [
    "El login nunca devuelve la contraseña ni el remember_token.",
    "Usuario inexistente y contraseña incorrecta devuelven el mismo mensaje, para no revelar qué usuarios existen.",
    "Un usuario con activo = false no puede iniciar sesión (403).",
    "El login admite 10 intentos por minuto; luego responde 429.",
    "logout revoca solo el token usado en esa petición."
  ],
  "rutas": [
    {
      "metodo": "POST",
      "ruta": "/api/login",
      "acceso": "Público",
      "peticion": {
        "usuario": "ana.prueba",
        "password": "secreto123"
      },
      "respuesta_200": {
        "success": true,
        "data": {
          "token": "1|Xk9...",
          "tipo_token": "Bearer",
          "usuario": {
            "id": 1,
            "nombres": "Ana",
            "apellidos": "Prueba",
            "usuario": "ana.prueba",
            "rol": "estudiante",
            "seccion_id": 1,
            "carrera_id": 3
          }
        },
        "message": "Sesión iniciada."
      },
      "respuesta_401": {
        "success": false,
        "data": null,
        "message": "Usuario o contraseña incorrectos.",
        "errors": {}
      },
      "respuesta_403": {
        "success": false,
        "data": null,
        "message": "Tu cuenta está desactivada. Comunícate con el administrador.",
        "errors": {}
      },
      "respuesta_422": {
        "success": false,
        "data": null,
        "message": "Los datos de inicio de sesión no son válidos.",
        "errors": {
          "usuario": ["El campo usuario es obligatorio."]
        }
      }
    },
    {
      "metodo": "GET",
      "ruta": "/api/me",
      "acceso": "Autenticado",
      "respuesta_200": {
        "success": true,
        "data": {
          "id": 1,
          "nombres": "Ana",
          "apellidos": "Prueba",
          "usuario": "ana.prueba",
          "rol": "estudiante",
          "seccion_id": 1,
          "carrera_id": 3
        },
        "message": "OK"
      },
      "respuesta_401": {
        "success": false,
        "data": null,
        "message": "Debes iniciar sesión.",
        "errors": {}
      }
    },
    {
      "metodo": "POST",
      "ruta": "/api/logout",
      "acceso": "Autenticado",
      "respuesta_200": {
        "success": true,
        "data": null,
        "message": "Sesión cerrada."
      },
      "respuesta_401": "Igual que en /api/me."
    }
  ]
}
