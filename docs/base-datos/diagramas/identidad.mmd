    timestamp updated_at
  }
  carreras {
    bigint id PK
    bigint area_postulacion_id FK
    varchar nombre
    boolean activo
    timestamp created_at
    timestamp updated_at
  }
  usuarios {
    bigint id PK
    varchar nombres
    varchar apellidos
